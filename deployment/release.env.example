# Required secrets. Generate long random values; never commit the real .env file.
MYSQL_DATABASE=aurora_commerce
MYSQL_USER=aurora
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Staging may use prod,demo. Production must use prod only.
SPRING_PROFILES_ACTIVE=prod,demo
DEMO_ADMIN_EMAIL=admin@aurora.local
DEMO_ADMIN_PASSWORD=replace-demo-admin-password

# Bind to loopback when a host-level HTTPS reverse proxy is used.
STOREFRONT_BIND_ADDRESS=127.0.0.1
STOREFRONT_PORT=3000
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=3001
