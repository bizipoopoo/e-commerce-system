# Demo deployment only. Copy to .env and replace every credential before sharing the environment.
MYSQL_DATABASE=aurora_commerce
MYSQL_USER=aurora
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt-signing

# The seeded administrator exists only when the demo profile is active.
DEMO_ADMIN_EMAIL=admin@aurora.local
DEMO_ADMIN_PASSWORD=Aurora@2026

# Published host ports; change these if they conflict with local services.
BACKEND_PORT=8080
STOREFRONT_PORT=3000
ADMIN_PORT=3001
